+	};
+	int i;
+	for (i = 0; i < sizeof(pwon_data)/sizeof(reg_value_t); i++) {
+		hdmi_writeb(hdmi, pwon_data[i].reg, pwon_data[i].value);
+	}
+	return;
+}
