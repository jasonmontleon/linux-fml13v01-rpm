+#ifdef CONFIG_PM_SLEEP
+static int cdns_dsi_system_pm_suspend(struct device *dev)
+{
+	return pm_runtime_force_suspend(dev);
+}
+
+static int cdns_dsi_system_pm_resume(struct device *dev)
+{
+	return pm_runtime_force_resume(dev);
+}
