+static void vs_vout_reset_get(struct device *dev, struct vs_dc *dc)
+{
+	//dc->rst_vout_src=reset_control_get_shared(dev, "rst_vout_src");
+	dc->rst_vout_src = reset_control_get_shared(dev, "rst_vout_src");
