From a10b38acaf3914562aec96e5e53cb1ab8010a91e Mon Sep 17 00:00:00 2001
From: "yang.wang" <yang.wang@deepcomputing.io>
Date: Mon, 9 Sep 2024 16:39:24 +0800
Subject: [PATCH 166/214] rfkill: wifi-rfkill.

Signed-off-by: yang.wang <yang.wang@deepcomputing.io>
---
 .../starfive/jh7110-starfive-visionfive-2-framework.dts    | 7 +++++++
 arch/riscv/configs/starfive_visionfive2_defconfig          | 1 +
 2 files changed, 8 insertions(+)

diff --git a/arch/riscv/boot/dts/starfive/jh7110-starfive-visionfive-2-framework.dts b/arch/riscv/boot/dts/starfive/jh7110-starfive-visionfive-2-framework.dts
index b43070d7e123..9cbed9c5a82d 100755
--- a/arch/riscv/boot/dts/starfive/jh7110-starfive-visionfive-2-framework.dts
+++ b/arch/riscv/boot/dts/starfive/jh7110-starfive-visionfive-2-framework.dts
@@ -83,6 +83,13 @@ xrp_reserved: xrpbuffer@f0000000 {
 //		};
 //	};
 
+	rfkill_wifi {
+		compatible = "rfkill-gpio";
+		label = "Wi-Fi";
+		radio-type = "wlan";
+		shutdown-gpios = <&sysgpio 55 GPIO_ACTIVE_HIGH>;
+	};
+
 	backlight: backlight {
 		compatible = "pwm-backlight";
 		pwms = <&pwm 0 5000000 0 >;
diff --git a/arch/riscv/configs/starfive_visionfive2_defconfig b/arch/riscv/configs/starfive_visionfive2_defconfig
index 07e870650baa..d4fd3aa041de 100644
--- a/arch/riscv/configs/starfive_visionfive2_defconfig
+++ b/arch/riscv/configs/starfive_visionfive2_defconfig
@@ -90,6 +90,7 @@ CONFIG_BT_AICUSB=y
 CONFIG_CFG80211=y
 CONFIG_MAC80211=y
 CONFIG_RFKILL=y
+CONFIG_RFKILL_GPIO=y
 CONFIG_NET_9P=y
 CONFIG_NET_9P_VIRTIO=y
 CONFIG_PCI=y
-- 
2.51.0

