From f9b7cc55e245e90dc5b29d73c060fecc0b3fee71 Mon Sep 17 00:00:00 2001
From: Heinrich Schuchardt <heinrich.schuchardt@canonical.com>
Date: Mon, 6 Jan 2025 11:46:41 +0100
Subject: [PATCH 200/214] riscv: fml13v01_defconfig: enable more monitoring
 interfaces

LXD needs these

Signed-off-by: Heinrich Schuchardt <heinrich.schuchardt@canonical.com>
---
 arch/riscv/configs/fml13v01_defconfig | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/riscv/configs/fml13v01_defconfig b/arch/riscv/configs/fml13v01_defconfig
index 083269d2898e..c6d89a2bdc9e 100644
--- a/arch/riscv/configs/fml13v01_defconfig
+++ b/arch/riscv/configs/fml13v01_defconfig
@@ -53,12 +53,18 @@ CONFIG_BINFMT_MISC=y
 CONFIG_PAGE_REPORTING=y
 CONFIG_NET=y
 CONFIG_PACKET=y
+CONFIG_PACKET_DIAG=m
+CONFIG_UNIX_DIAG=m
 CONFIG_IP_MULTICAST=y
 CONFIG_IP_ADVANCED_ROUTER=y
 CONFIG_IP_PNP=y
 CONFIG_IP_PNP_DHCP=y
 CONFIG_IP_PNP_BOOTP=y
 CONFIG_IP_PNP_RARP=y
+CONFIG_INET_DIAG=m
+CONFIG_INET_UDP_DIAG=m
+CONFIG_INET_RAW_DIAG=m
+CONFIG_INET_DIAG_DESTROY=y
 CONFIG_NETFILTER=y
 CONFIG_NETFILTER_NETLINK_ACCT=y
 CONFIG_NETFILTER_NETLINK_QUEUE=y
-- 
2.51.0

