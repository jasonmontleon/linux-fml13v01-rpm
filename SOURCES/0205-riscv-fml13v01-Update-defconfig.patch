 CONFIG_SECURITY_SAFESETID=y
 CONFIG_LSM="landlock,lockdown,yama,integrity,apparmor"
 CONFIG_INIT_STACK_NONE=y
+CONFIG_RANDSTRUCT_NONE=y
 CONFIG_CRYPTO_USER=y
 CONFIG_CRYPTO_TEST=m
 CONFIG_CRYPTO_DEFLATE=y
