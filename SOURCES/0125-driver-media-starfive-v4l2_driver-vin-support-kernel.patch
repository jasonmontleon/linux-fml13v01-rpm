-		regulator_disable(csi_dev->mipirx_1p8);
+	} else
 		regulator_disable(csi_dev->mipirx_0p9);
-	}
 
 	regmap_update_bits(stfcamss->stf_aon_syscon, stfcamss->aon_gp_reg,
 				BIT(31), BIT(31));
 
