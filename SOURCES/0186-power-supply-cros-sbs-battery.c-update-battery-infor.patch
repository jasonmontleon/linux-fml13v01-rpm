From b65b7ece1020bbeba9440d61905e37afdd604d51 Mon Sep 17 00:00:00 2001
From: "yang.wang" <yang.wang@deepcomputing.io>
Date: Thu, 31 Oct 2024 17:49:07 +0800
Subject: [PATCH 186/214] power supply: cros-sbs-battery.c: update battery
 information on power in and power out.

Signed-off-by: yang.wang <yang.wang@deepcomputing.io>
---
 drivers/power/supply/cros-sbs-battery.c | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/drivers/power/supply/cros-sbs-battery.c b/drivers/power/supply/cros-sbs-battery.c
index 8e5f8e8c3df7..17d5e6679927 100644
--- a/drivers/power/supply/cros-sbs-battery.c
+++ b/drivers/power/supply/cros-sbs-battery.c
@@ -1049,14 +1049,26 @@ static int cros_sbs_ec_notify(struct notifier_block *nb,
 	struct cros_ec_device *ec_dev = data;
 	struct cros_sbs_info *chip = container_of(nb, struct cros_sbs_info, notifier);
 	u32 host_event;
+	u32 mask;
 
 	if (ec_dev->event_size != sizeof(host_event))
 		return NOTIFY_DONE;
 
 	host_event = get_unaligned_le32(&ec_dev->event_data.data.host_event);
 
-	dev_dbg(chip->dev, "%s event_type: %d, host_event: 0x%x\n", __func__,
-		ec_dev->event_data.event_type, host_event);
+	if (ec_dev->event_data.event_type != EC_MKBP_EVENT_HOST_EVENT)
+		return NOTIFY_DONE;
+
+	mask = EC_HOST_EVENT_MASK(EC_HOST_EVENT_AC_CONNECTED) |
+	       EC_HOST_EVENT_MASK(EC_HOST_EVENT_AC_DISCONNECTED);
+	if (host_event & mask) {
+		dev_info(chip->dev, "%s: %s\n", __func__,
+			 (host_event &
+			  EC_HOST_EVENT_MASK(EC_HOST_EVENT_AC_CONNECTED)) ?
+				 "AC_CONNECTED" :
+				 "AC_DISCONNECTED");
+		cros_sbs_supply_changed(chip);
+	}
 
 	return NOTIFY_DONE;
 }
-- 
