From 6f3e323f06405868652332b6e0fd3088e7f0e002 Mon Sep 17 00:00:00 2001
From: "shanlong.li" <shanlong.li@starfivetech.com>
Date: Mon, 10 Jul 2023 03:07:57 -0700
Subject: [PATCH 067/214] driver:uart: fix up uart communicate fail

fix up uart communicate fail

Signed-off-by: shanlong.li <shanlong.li@starfivetech.com>
---
 drivers/tty/serial/8250/8250_dw.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/drivers/tty/serial/8250/8250_dw.c b/drivers/tty/serial/8250/8250_dw.c
index a38fa644d08b..4f630838e816 100644
--- a/drivers/tty/serial/8250/8250_dw.c
+++ b/drivers/tty/serial/8250/8250_dw.c
@@ -655,9 +655,10 @@ static int dw8250_probe(struct platform_device *pdev)
 	if (err)
 		return err;
 
-	data->rst = devm_reset_control_get_optional_exclusive(dev, NULL);
-	if (IS_ERR(data->rst))
-		return PTR_ERR(data->rst);
+	data->rst = devm_reset_control_array_get_exclusive(dev);
+	if (IS_ERR(data->rst)) {
+		err = PTR_ERR(data->rst);
+	}
 
 	err = reset_control_deassert(data->rst);
 	if (err)
-- 
