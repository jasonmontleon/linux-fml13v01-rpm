+
+static int sdio_suspend(struct eswin *tr)
+{
+	atomic_set(&suspend, 1);
+	return 0;
+}
+
+static int sdio_resume(struct eswin *tr)
+{
+	atomic_set(&suspend, 0);
+	return 0;
+}
