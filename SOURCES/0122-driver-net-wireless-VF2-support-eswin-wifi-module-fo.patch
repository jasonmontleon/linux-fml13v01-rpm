+ */
+static int sdio_host_msgack_handler(struct ipc_host_env_tag *env, struct sk_buff *skb)
+{
+    uint64_t hostid = *(uint64_t *)skb->data;
+
+    ASSERT_ERR(hostid);
+
+    env->msga2e_hostid = NULL;
+    env->cb.recv_msgack_ind(env->pthis, hostid);
+
+    return 0;
+}
