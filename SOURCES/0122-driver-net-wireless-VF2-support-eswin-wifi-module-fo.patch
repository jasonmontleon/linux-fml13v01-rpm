+static void dump_mgmt_rx(struct hw_rxhdr *hw_rxhdr)
+{
+	ECRNX_DBG("%s, amsdu:%d, 80211_mpdu:%d, 4addr:%d, vif_idx:%d, sta_idx:%d, dst_idx:%d \n", \
+		__func__, \
+		hw_rxhdr->flags_is_amsdu, \
+		hw_rxhdr->flags_is_80211_mpdu, \
+		hw_rxhdr->flags_is_4addr, \
