+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 0, 0)
+#define cfg80211_notify_new_peer_candidate(dev, addr, ie, ie_len, sig_dbm, gfp) \
+    cfg80211_notify_new_peer_candidate(dev, addr, ie, ie_len, gfp)
+
