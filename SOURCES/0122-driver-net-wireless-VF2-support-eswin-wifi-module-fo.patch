+static void __exit eswin_sdio_exit(void)
+{
+	ECRNX_PRINT(" %s entry!!", __func__);
+	sdio_unregister_driver(&eswin_sdio_driver);
+	ECRNX_PRINT(" %s exit!!", __func__);
+}
