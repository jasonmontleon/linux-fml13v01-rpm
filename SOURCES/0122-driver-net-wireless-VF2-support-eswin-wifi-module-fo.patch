+
+
+struct ecrnx_element {
+    u8 id;
+    u8 datalen;
+    u8 data[];
+} __packed;
+
+
+#define for_each_ecrnx_element(_elem, _data, _datalen)			\
+	for (_elem = (const struct ecrnx_element *)(_data);			\
+	     (const u8 *)(_data) + (_datalen) - (const u8 *)_elem >=	\
+		(int)sizeof(*_elem) &&					\
+	     (const u8 *)(_data) + (_datalen) - (const u8 *)_elem >=	\
+		(int)sizeof(*_elem) + _elem->datalen;			\
