+static void update_netstatus_simulation(struct server *server)
+{
+	if (!server->netstatus_enabled) {
+		timeout_remove(server->netstatus_timeout_id);
+		return;
+	}
+
+	server->netstatus_timeout_id = timeout_add(1000, netstatus_cb, server, NULL);
+}
