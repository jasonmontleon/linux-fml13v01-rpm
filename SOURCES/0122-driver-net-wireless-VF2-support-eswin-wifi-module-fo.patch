+#define EIRQ_IO_ENABLE	(1<<2)
+#define EIRQ_EDGE	(1<<1)
+#define EIRQ_ACTIVE_LO	(1<<0)
+
+#define EIRQ_DEV_SLEEP	(1<<3)
+#define EIRQ_DEV_READY	(1<<2)
+#define EIRQ_RXQ	(1<<1)
+#define EIRQ_TXQ	(1<<0)
+
+#define TXQ_ERROR	(1<<7)
+#define TXQ_SLOT_COUNT	(0x7F)
+#define RXQ_SLOT_COUNT	(0x7F)
+
+} __packed;
