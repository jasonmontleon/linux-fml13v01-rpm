+#ifndef CONFIG_ECRNX_ESWIN
+void ecrnx_ipc_rxdesc_elem_repush(struct ecrnx_hw *ecrnx_hw,
+                                 struct ecrnx_ipc_elem *elem)
+{
+    struct rxdesc_tag *rxdesc = elem->addr;
