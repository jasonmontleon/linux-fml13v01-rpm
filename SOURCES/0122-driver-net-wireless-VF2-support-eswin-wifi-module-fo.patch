+    ECRNX_HWQ_BE,
+    ECRNX_HWQ_VI,
+    ECRNX_HWQ_VI,
+    ECRNX_HWQ_VO,
+    ECRNX_HWQ_VO,
+    /* TID_8 is used for management frames */
+    ECRNX_HWQ_VO,
+    /* At the moment, all others TID are mapped to BE */
+    ECRNX_HWQ_BE,
+    ECRNX_HWQ_BE,
+    ECRNX_HWQ_BE,
+    ECRNX_HWQ_BE,
+    ECRNX_HWQ_BE,
+    ECRNX_HWQ_BE,
+    ECRNX_HWQ_BE,
+};
