+int cli_parse_args(uint8_t* str, char* argv[])
+{
+    int i = 0;
+    char* ch = (char *)str;
+
+    while(*ch == ' ') ch++;
+    if (*ch == '\n')
+        return 0;
+
+    while(*ch != '\0') 
+    {
+        i++;
+
+        if (i > MAX_ARGV)
+            return 0;
+
+        argv[i-1] = ch;
+        while(*ch != '\0')
+        {
+            if(*ch == ' ')
+                break;
+            else
+                ch++;
+        }
+
+        *ch = '\0';
+        ch++;
+        while(*ch == ' ') {
+            ch++;
+        }
+    }
+
+    return i;
+}
