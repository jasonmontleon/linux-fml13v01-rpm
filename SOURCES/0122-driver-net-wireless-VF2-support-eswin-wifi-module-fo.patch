+	struct timer_list timer;
+};
+
+
+/* Private txq driver data structure */
+struct eswin_txq {
+	u16 hw_queue; /* 0: AC_BK, 1: AC_BE, 2: AC_VI, 3: AC_VO */
+	struct list_head list;
+	struct sk_buff_head queue; /* own queue */
+	unsigned long nr_fw_queueud;
